# Gemini API key (aistudio.google.com/apikey) for chat + embeddings.
# Preferred provider. Leave unset to run without AI.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Alternative: Vercel AI Gateway key (used only when no Gemini key is set).
# AI_GATEWAY_API_KEY=
# AI_MODEL=openai/gpt-5.4-mini

# Postgres connection string for production. When unset the app uses PGlite
# (embedded Postgres) stored at PGLITE_DIR.
# DATABASE_URL=postgres://user:password@host:5432/dbname
PGLITE_DIR=./.data/pglite
